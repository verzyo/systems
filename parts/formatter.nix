{inputs, ...}: {
  imports = [inputs.treefmt-nix.flakeModule];

  flake-file = {
    inputs.treefmt-nix.url = "github:numtide/treefmt-nix";
    formatter = pkgs: pkgs.alejandra;
  };

  perSystem.treefmt = {
    # generated by nixos-facter, keep as-is
    settings.global.excludes = ["hosts/*/hardware.json"];

    programs = {
      alejandra.enable = true;
      statix.enable = true;
      deadnix.enable = true;

      biome = {
        enable = true;
        includes = ["*.json"];
      };
    };
  };
}
